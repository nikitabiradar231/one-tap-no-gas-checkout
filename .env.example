# Privy Application ID (Get from https://dashboard.privy.io)
NEXT_PUBLIC_PRIVY_APP_ID=clx_demo_privy_app_id

# Target Network (84532 for Base Sepolia Testnet)
NEXT_PUBLIC_CHAIN_ID=84532

# Testnet RPC Endpoint
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org

# Paymaster / Gas Sponsorship Service URL (e.g. Pimlico, ZeroDev, Biconomy, or Privy dashboard sponsor)
NEXT_PUBLIC_PAYMASTER_URL=https://api.pimlico.io/v2/84532/rpc?apikey=your_pimlico_api_key

# Test ERC-20 Token Contract Address (e.g. Test USDC on Base Sepolia)
NEXT_PUBLIC_TOKEN_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Merchant / Shop Vault Address (Receives token payment)
NEXT_PUBLIC_MERCHANT_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
